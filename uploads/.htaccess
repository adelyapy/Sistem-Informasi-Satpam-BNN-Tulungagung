Options -Indexes -ExecCGI

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py .sh .exe .dll .bat .cmd
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py .sh .exe .dll .bat .cmd

<FilesMatch "\.(php|phtml|php[3-8]?|phar|cgi|pl|py|sh|exe|dll|bat|cmd)$">
    Require all denied
</FilesMatch>
